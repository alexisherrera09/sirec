# === SIREC — archivos que NO se versionan ===

# .NET (artefactos de compilación)
bin/
obj/
*.user
.vs/

# Python (entornos y cachés)
.venv/
__pycache__/
*.pyc
*.egg-info/

# Node / Vite (dependencias y build)
node_modules/
dist/
*.local

# Modelos BETO entrenados: ~440 MB por archivo → GitHub rechaza >100 MB, NO pueden ir al repo.
# Se generan con datos-modelo/entrenar_beto_colab.ipynb y se despliegan aparte
# (ver microservicio-ml/DESPLIEGUE_MODELO.md: scp del zip a la EC2 o re-entrenar).
microservicio-ml/modelos/
datos-modelo/beto_categoria/
datos-modelo/beto_urgencia/
*.zip
*.safetensors
pytorch_model.bin

# Sistema
Thumbs.db
.DS_Store

# Videos y audio (no se versionan por tamaño; sí se versionan sus transcripciones .md y los scripts)
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.mp3
*.wav
*.m4a

# Nota: appsettings.Development.json SÍ se versiona (repo privado, credenciales
# solo de desarrollo). Las credenciales de PRODUCCIÓN nunca van al repositorio.

# Entorno para generar los documentos de las entregas (python-docx, matplotlib)
.venv-docs/
